# =====================================================================
# Variables de entorno - Convivo Config Server
# =====================================================================

# Token generado en SonarQube (http://localhost:9000 -> My Account -> Security)
SONAR_TOKEN=

# Base de datos SonarQube (PostgreSQL)
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonarpassword
SONAR_DB_NAME=sonar

# Config Server (produccion: obligatorias, sin defaults)
CONFIG_SERVER_USER=
# Texto plano o hash: {bcrypt}$2a$10$...  (los clientes siempre usan la clave en texto plano)
CONFIG_SERVER_PASSWORD=
# Keystore TLS montado en runtime, nunca en el repo
SSL_KEYSTORE_PATH=file:/run/secrets/keystore.p12
SSL_KEYSTORE_PASSWORD=
